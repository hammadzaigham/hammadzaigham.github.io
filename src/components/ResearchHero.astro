---
import Chevron from './Chevron.astro';
import { RESEARCH_DATA } from '../data/researchData';
const { candidate } = RESEARCH_DATA;
---
<section class="hero-section" id="identity" aria-labelledby="identity-title">
  <div class="atlas-container hero-layout">
    <div class="hero-main-content">
      <p class="eyebrow">Computer science · University of Southern Mississippi</p>
      <h1 class="hero-headline" id="identity-title">Hammad Ahmed<span class="name-period">.</span></h1>
      <p class="hero-research-line">Perception, reasoning &amp;<br /><em>trustworthy systems.</em></p>
      <p class="hero-standfirst">I study how AI agents understand the physical world and act reliably within it. My work spans vision–language navigation, roadway perception, and secure infrastructure.</p>
      <p class="hero-narrative">Undergraduate researcher in <strong>SPEN Lab</strong>, advised by <strong>Dr. Ahmed Sherif</strong>.</p>
      <div class="hero-actions-row"><a href="#publications" class="btn-academic btn-primary">Publications<Chevron /></a><a href={import.meta.env.BASE_URL + 'cv/'} class="btn-academic btn-secondary">Curriculum vitae<Chevron /></a></div>
      <div class="hero-contact"><a href={'mailto:' + candidate.email}>Email</a><span aria-hidden="true">/</span><a href={candidate.github} target="_blank" rel="noopener noreferrer">GitHub</a><span aria-hidden="true">/</span><span>Hattiesburg, Mississippi</span></div>
    </div>
    <aside class="research-notes" id="research-map" aria-label="Research interests and education">
      <h2>Research interests</h2>
      <ul class="interest-list">
        <li><a href="#pub-dygrav-2026">Embodied AI &amp; navigation</a><p>Grounding language in visual landmarks and relational graphs.</p></li>
        <li><a href="#case-roadwatch">Perception in the physical world</a><p>Roadway detection, segmentation, and human-reviewed triage.</p></li>
        <li><a href="#case-dwc-fastauth">Secure infrastructure &amp; systems</a><p>EV charging authentication and low-level hardware interfaces.</p></li>
      </ul>
      <p class="education-note"><strong>B.S. Computer Science</strong><br />Minor in Economic Data Analysis<br /><span>Expected May 2027 · GPA 4.00 / 4.00</span></p>
    </aside>
  </div>
</section>


---
import Chevron from './Chevron.astro';
import { RESEARCH_DATA } from '../data/researchData';
import RoadWatchFigure from './RoadWatchFigure.astro';
const { caseStudies } = RESEARCH_DATA;
---
<section class="case-studies-section" id="case-studies" aria-labelledby="projects-title"><div class="atlas-container">
  <div class="section-header"><h2 class="section-title" id="projects-title">Projects</h2><p class="section-desc">From experiments and evaluation to the systems that make them useful.</p></div>
  <div class="case-studies-grid">{caseStudies.map((cs, index) => <article class={'case-card case-card-' + cs.pillar} id={'case-' + cs.id}>
    <div class="case-header-row"><span class="project-number">{index === 0 ? 'Featured investigation' : cs.id === 'dwc-fastauth' ? 'Ongoing research' : cs.role}</span><span class="project-period">{cs.period}</span></div>
    <h3 class="case-title">{cs.title}</h3><p class="case-subtitle">{cs.role} · {cs.id === 'roadwatch' ? 'Mississippi AI Innovation Hub' : cs.id === 'preysense' ? 'Independent / open source' : 'SPEN Lab, USM'}</p>
    <p class="case-summary">{cs.summary}</p>
    {cs.id === 'roadwatch' && <RoadWatchFigure />}
    <dl class="case-metrics-grid">{cs.verifiedMetrics.slice(0,3).map(metric => <div class="case-metric-item"><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>
    <details class="project-details"><summary>Methods &amp; contributions <span aria-hidden="true">+</span></summary><ul class="case-highlights-list">{cs.technicalHighlights.map(highlight => <li>{highlight}</li>)}</ul></details>
    <div class="case-actions">
      {cs.liveUrl && <a href={cs.liveUrl} target="_blank" rel="noopener noreferrer" class="action-link-btn">Open RoadWatch <Chevron /></a>}
      {cs.githubUrl && <a href={cs.githubUrl} target="_blank" rel="noopener noreferrer" class="action-link-btn">Source on GitHub <Chevron /></a>}
      {cs.artifacts.filter(artifact => artifact.url && artifact.url !== cs.liveUrl && artifact.url !== cs.githubUrl).map(artifact => <a href={artifact.url} target="_blank" rel="noopener noreferrer" class="action-link-btn">Read paper <Chevron /></a>)}
      {cs.id === 'dwc-fastauth' && <a href="#pub-ev-auth-2026" class="action-link-btn">Related accepted survey <Chevron /></a>}
    </div>
  </article>)}</div>
</div></section>

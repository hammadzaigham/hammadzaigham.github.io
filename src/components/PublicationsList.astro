---
import Chevron from './Chevron.astro';
import { RESEARCH_DATA } from '../data/researchData';
import ResearchFigure from './ResearchFigure.astro';
const { publications } = RESEARCH_DATA;
---
<section class="publications-section" id="publications" aria-labelledby="publications-title"><div class="atlas-container">
  <div class="section-header"><h2 class="section-title" id="publications-title">Publications</h2><p class="section-desc">Work on embodied navigation and the security of intelligent infrastructure.</p></div>
  <div class="pub-list">{publications.map(pub => <article class="pub-item-card" id={'pub-' + pub.id}>
    <ResearchFigure kind={pub.pillar} />
    <div class="pub-text-wrap">
      <p class="pub-venue-line">{pub.id === 'dygrav-2026' ? pub.venue + ' · ' + pub.year : 'ISBCom · ' + pub.year + ' · Accepted; Springer LNNS proceedings forthcoming'}</p>
      <h3 class="pub-title">{pub.doiUrl ? <a href={pub.doiUrl} target="_blank" rel="noopener noreferrer">{pub.title}</a> : pub.title}</h3>
      <p class="pub-authors">{pub.authors.map((author, index) => <span>{author.isCandidate ? <strong class="author-candidate">{author.name}</strong> : author.name}{index < pub.authors.length - 1 ? ', ' : '.'}</span>)}</p>
      <p class="pub-abstract">{pub.summary}</p>
      <p class="pub-result">{pub.id === 'dygrav-2026' ? 'R2R val_unseen: 80.28% success rate · 76.41% SPL' : 'A two-step 4 × 4 taxonomy of 53 EV charging studies.'}</p>
      <div class="pub-actions-row">
        {pub.doiUrl && <a href={pub.doiUrl} target="_blank" rel="noopener noreferrer" class="action-link-btn">Read paper <Chevron /></a>}
        <button type="button" class="action-link-btn open-bibtex-btn" data-pub-id={pub.id} data-title={pub.title} data-bibtex={pub.bibtex} aria-label={'Open BibTeX for ' + pub.title} aria-haspopup="dialog">Cite / BibTeX</button>
        <a href={pub.id === 'dygrav-2026' ? '#case-dygrav' : '#case-dwc-fastauth'} class="action-link-btn">{pub.id === 'dygrav-2026' ? 'My contribution' : 'Related ongoing research'} <Chevron /></a>
      </div>
    </div>
  </article>)}</div>
</div></section>

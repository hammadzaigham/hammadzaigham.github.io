<dialog id="bibtex-dialog" aria-labelledby="modal-title" aria-describedby="modal-paper-name">
  <div class="modal-header-row"><h2 id="modal-title">BibTeX citation</h2><button type="button" class="modal-close-btn" aria-label="Close citation dialog">×</button></div>
  <p id="modal-paper-name"></p><pre id="modal-bibtex-code" tabindex="0" aria-label="BibTeX citation text"></pre>
  <div class="modal-footer-row"><p id="copy-status" role="status" aria-live="polite"></p><button type="button" class="btn-academic btn-primary" id="modal-copy-btn">Copy citation</button></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#bibtex-dialog');
  const title = document.getElementById('modal-paper-name');
  const code = document.getElementById('modal-bibtex-code');
  const status = document.getElementById('copy-status');
  let trigger: HTMLButtonElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('.open-bibtex-btn').forEach(button => {
    button.addEventListener('click', () => {
      if (!dialog || !title || !code || !status) return;
      trigger = button; title.textContent = button.dataset.title ?? ''; code.textContent = button.dataset.bibtex ?? ''; status.textContent = '';
      dialog.showModal(); document.body.classList.add('dialog-open');
    });
  });
  dialog?.querySelector('.modal-close-btn')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', event => {
    const rect = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
  });
  dialog?.addEventListener('close', () => { document.body.classList.remove('dialog-open'); trigger?.focus(); });
  document.getElementById('modal-copy-btn')?.addEventListener('click', async () => {
    if (!code || !status) return;
    try { await navigator.clipboard.writeText(code.textContent ?? ''); status.textContent = 'Citation copied.'; }
    catch { const range = document.createRange(); range.selectNodeContents(code); const selection = window.getSelection(); selection?.removeAllRanges(); selection?.addRange(range); code.focus(); status.textContent = 'Copy unavailable. Citation selected; press Ctrl+C or ⌘C.'; }
  });
</script>

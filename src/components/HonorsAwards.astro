---
import { RESEARCH_DATA } from '../data/researchData';
const { honors, leadership, skillsTaxonomy } = RESEARCH_DATA;
---
<section class="honors-section" id="honors" aria-labelledby="honors-title"><div class="atlas-container">
  <div class="section-header"><h2 class="section-title" id="honors-title">Honors &amp; service</h2></div>
  <div class="honors-grid">{honors.map(honor => <article class="honor-item-box"><p class="honor-year">{honor.year}</p><h3 class="honor-title">{honor.link ? <a href={honor.link} target="_blank" rel="noopener noreferrer">{honor.title} </a> : honor.title}</h3><p class="honor-issuer">{honor.issuer}</p><p class="honor-desc">{honor.description}</p></article>)}</div>
  <div class="service-layout"><h3 class="subsection-title">Leadership &amp; service</h3><div class="leadership-list">{leadership.map(item => <article><h4>{item.role}</h4><p>{item.organization}</p><span class="project-period">{item.period}</span></article>)}</div></div>
  <div class="skills-layout"><h3 class="subsection-title">Technical toolkit</h3><div class="skills-list">{skillsTaxonomy.map(category => <div><h4>{category.domain}</h4><p>{category.skills.join(' · ')}</p></div>)}</div></div>
</div></section>

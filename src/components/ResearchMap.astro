---
---

<section class="research-map-section" id="research-map">
  <div class="atlas-container">
    <div class="section-header">
      <div class="section-eyebrow">
        <span class="section-number">01 / CONCEPTUAL ARCHITECTURE</span>
        <span class="mono-tag">Interactive Research Atlas</span>
      </div>
      <h2 class="section-title serif-heading">The Research Atlas: Perception, Reasoning &amp; Trust</h2>
      <p class="section-desc">
        A unified conceptual framework bridging real-time environmental perception, relational language grounding in embodied agents, and verified low-level systems execution. Hover any pillar to trace cross-domain bridges.
      </p>
    </div>

    <!-- The Signature SVG Scientific Diagram -->
    <div class="atlas-map-wrapper">
      <!-- Technical frame metadata header -->
      <div class="map-technical-toolbar">
        <div class="toolbar-left">
          <span class="tech-badge"><span class="tech-pulse"></span> SYSTEM ARCHITECTURE // MAP 1.0</span>
          <span class="tech-coord">LAT 31.3297° N · LON 89.3338° W</span>
        </div>
        <div class="toolbar-right">
          <span class="tech-spec">SCALE: 1:1 CONVERGENCE</span>
          <span class="tech-spec">STATUS: VERIFIED EMPIRICAL</span>
        </div>
      </div>

      <svg
        class="map-svg-container"
        viewBox="0 0 960 460"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Conceptual diagram connecting Perception, Reasoning, and Trustworthy Systems"
      >
        <defs>
          <!-- Technical Grid Pattern -->
          <pattern id="atlas-dot-grid" width="24" height="24" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1" fill="#CBD5E1" opacity="0.55" />
          </pattern>

          <!-- Drop Shadows for Cards -->
          <filter id="node-shadow" x="-8%" y="-8%" width="120%" height="125%" filterUnits="userSpaceOnUse">
            <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#182334" flood-opacity="0.08" />
            <feDropShadow dx="0" dy="1" stdDeviation="2" flood-color="#182334" flood-opacity="0.04" />
          </filter>
          <filter id="pill-shadow" x="-10%" y="-15%" width="120%" height="140%" filterUnits="userSpaceOnUse">
            <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#182334" flood-opacity="0.07" />
          </filter>

          <!-- Marker Arrows -->
          <marker id="arrow-cobalt" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#3157B8" />
          </marker>
          <marker id="arrow-emerald" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#0D825E" />
          </marker>
          <marker id="arrow-amber" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#B45309" />
          </marker>

          <!-- Card Header Gradients -->
          <linearGradient id="header-grad-perception" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#E8F5E9" />
            <stop offset="100%" stop-color="#F1F8F5" />
          </linearGradient>
          <linearGradient id="header-grad-reasoning" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#EBF1FC" />
            <stop offset="100%" stop-color="#F2F6FD" />
          </linearGradient>
          <linearGradient id="header-grad-trust" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#FEF3C7" />
            <stop offset="100%" stop-color="#FFFBEB" />
          </linearGradient>

          <!-- Central Core Radar Radial Glow -->
          <radialGradient id="hub-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#3157B8" stop-opacity="0.18" />
            <stop offset="70%" stop-color="#3157B8" stop-opacity="0.04" />
            <stop offset="100%" stop-color="#3157B8" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- Technical Blueprint Background Canvas -->
        <rect x="0" y="0" width="960" height="460" rx="8" fill="#FBFDFF" />
        <rect x="0" y="0" width="960" height="460" rx="8" fill="url(#atlas-dot-grid)" />
        <rect x="1" y="1" width="958" height="458" rx="7" fill="none" stroke="#E2E8F0" stroke-width="1.5" />

        <!-- Technical Outer Reticle Corner Ticks (+) -->
        <g stroke="#94A3B8" stroke-width="1.25" opacity="0.8">
          <!-- Top-Left -->
          <line x1="16" y1="12" x2="16" y2="24" />
          <line x1="10" y1="18" x2="22" y2="18" />
          <!-- Top-Right -->
          <line x1="944" y1="12" x2="944" y2="24" />
          <line x1="938" y1="18" x2="950" y2="18" />
          <!-- Bottom-Left -->
          <line x1="16" y1="436" x2="16" y2="448" />
          <line x1="10" y1="442" x2="22" y2="442" />
          <!-- Bottom-Right -->
          <line x1="944" y1="436" x2="944" y2="448" />
          <line x1="938" y1="442" x2="950" y2="442" />
        </g>

        <!-- Technical Axis Coordinates -->
        <text x="36" y="24" fill="#94A3B8" font-family="IBM Plex Mono" font-size="8.5" letter-spacing="1">COORD: [01_INPUT] // RAW SENSOR DATA</text>
        <text x="924" y="24" fill="#94A3B8" font-family="IBM Plex Mono" font-size="8.5" text-anchor="end" letter-spacing="1">COORD: [02_PLANNING] // TOPOLOGICAL ACTION</text>
        <text x="480" y="446" fill="#94A3B8" font-family="IBM Plex Mono" font-size="8.5" text-anchor="middle" letter-spacing="1">COORD: [03_BOUNDS] // ACPI FIRMWARE &amp; HARDWARE ENVELOPE</text>

        <!-- ================= CONNECTING PATHWAYS ================= -->

        <!-- Path 1: Perception to Reasoning (Spatial Grounding Bridge) -->
        <!-- Background guide track -->
        <path
          d="M 290 120 C 390 65, 570 65, 670 120"
          stroke="#EBF1FC"
          stroke-width="6"
          stroke-linecap="round"
        />
        <!-- Active animated pathway -->
        <path
          class="animated-flow-path path-cobalt"
          d="M 290 120 C 390 65, 570 65, 670 120"
          stroke="#3157B8"
          stroke-width="2"
          stroke-dasharray="6 5"
          marker-end="url(#arrow-cobalt)"
        />
        <!-- Pill Label 1 -->
        <g transform="translate(480, 68)">
          <rect x="-195" y="-14" width="390" height="26" rx="13" fill="#FFFFFF" stroke="#3157B8" stroke-width="1.25" filter="url(#pill-shadow)" />
          <circle cx="-178" cy="-1" r="3.5" fill="#3157B8" />
          <text x="-166" y="3" fill="#182334" font-family="IBM Plex Mono" font-size="9.5" font-weight="600">
            SPATIAL GROUNDING:
          </text>
          <text x="-36" y="3" fill="#3157B8" font-family="IBM Plex Mono" font-size="9.5">
            Dynamic Attention → Visual Primitives
          </text>
        </g>

        <!-- Path 2: Reasoning to Trustworthy Systems (Policy Limits Bridge) -->
        <!-- Background guide track -->
        <path
          d="M 740 220 C 730 300, 620 335, 550 345"
          stroke="#FEF3C7"
          stroke-width="6"
          stroke-linecap="round"
        />
        <!-- Active animated pathway -->
        <path
          class="animated-flow-path path-amber"
          d="M 740 220 C 730 300, 620 335, 550 345"
          stroke="#B45309"
          stroke-width="2"
          stroke-dasharray="6 5"
          marker-end="url(#arrow-amber)"
        />
        <!-- Pill Label 2 -->
        <g transform="translate(685, 290)">
          <rect x="0" y="-13" width="225" height="26" rx="13" fill="#FFFFFF" stroke="#B45309" stroke-width="1.25" filter="url(#pill-shadow)" />
          <circle cx="14" cy="0" r="3.5" fill="#B45309" />
          <text x="24" y="4" fill="#B45309" font-family="IBM Plex Mono" font-size="9" font-weight="600">
            POLICY LIMITS → 97.3% COMPUTE
          </text>
        </g>

        <!-- Path 3: Trustworthy Systems to Perception (Edge Sensor Bounds) -->
        <!-- Background guide track -->
        <path
          d="M 410 345 C 340 335, 230 300, 220 220"
          stroke="#E8F5E9"
          stroke-width="6"
          stroke-linecap="round"
        />
        <!-- Active animated pathway -->
        <path
          class="animated-flow-path path-emerald"
          d="M 410 345 C 340 335, 230 300, 220 220"
          stroke="#0D825E"
          stroke-width="2"
          stroke-dasharray="6 5"
          marker-end="url(#arrow-emerald)"
        />
        <!-- Pill Label 3 -->
        <g transform="translate(50, 290)">
          <rect x="0" y="-13" width="225" height="26" rx="13" fill="#FFFFFF" stroke="#0D825E" stroke-width="1.25" filter="url(#pill-shadow)" />
          <circle cx="14" cy="0" r="3.5" fill="#0D825E" />
          <text x="24" y="4" fill="#0D825E" font-family="IBM Plex Mono" font-size="9" font-weight="600">
            EDGE TRIAGE ← SUB-MS BOUNDS
          </text>
        </g>

        <!-- ================= CENTRAL CONVERGENCE RETICLE ================= -->
        <g class="convergence-hub" transform="translate(480, 225)">
          <!-- Ambient Glow Aura -->
          <circle cx="0" cy="0" r="68" fill="url(#hub-glow)" />

          <!-- Outer Orbit Dash Ring -->
          <circle cx="0" cy="0" r="50" fill="none" stroke="#CBD5E1" stroke-width="1.2" stroke-dasharray="4 4" class="orbit-ring" />

          <!-- Inner Alignment Ring -->
          <circle cx="0" cy="0" r="34" fill="#FFFFFF" stroke="#94A3B8" stroke-width="1" />

          <!-- Cardinal Crosshair Ticks -->
          <line x1="0" y1="-56" x2="0" y2="-44" stroke="#3157B8" stroke-width="1.5" />
          <line x1="0" y1="44" x2="0" y2="56" stroke="#3157B8" stroke-width="1.5" />
          <line x1="-56" y1="0" x2="-44" y2="0" stroke="#3157B8" stroke-width="1.5" />
          <line x1="44" y1="0" x2="56" y2="0" stroke="#3157B8" stroke-width="1.5" />

          <!-- Central Core Pulsing Point -->
          <circle cx="0" cy="0" r="10" fill="#EBF1FC" />
          <circle cx="0" cy="0" r="5" fill="#3157B8" />

          <!-- Hub Inscriptions -->
          <text x="0" y="-12" fill="#182334" font-family="IBM Plex Mono" font-size="9" text-anchor="middle" font-weight="700" letter-spacing="1">
            ATLAS
          </text>
          <text x="0" y="21" fill="#3157B8" font-family="IBM Plex Mono" font-size="7.5" text-anchor="middle" font-weight="600" letter-spacing="0.5">
            CONVERGENCE
          </text>
          <text x="0" y="74" fill="#64748B" font-family="IBM Plex Mono" font-size="8" text-anchor="middle">
            P ⊗ R ⊗ T SYNERGY
          </text>
        </g>

        <!-- ================= PILLAR 1: PERCEPTION ================= -->
        <g class="map-pillar-card" id="pillar-perception" transform="translate(45, 65)">
          <!-- Card Body with Shadow -->
          <rect x="0" y="0" width="245" height="150" rx="8" fill="#FFFFFF" stroke="#0D825E" stroke-width="1.5" filter="url(#node-shadow)" />

          <!-- Header Bar -->
          <rect x="1" y="1" width="243" height="36" rx="7" fill="url(#header-grad-perception)" />
          <line x1="0" y1="37" x2="245" y2="37" stroke="rgba(13, 130, 94, 0.25)" stroke-width="1" />

          <!-- Header Icons & Title -->
          <circle cx="18" cy="19" r="4.5" fill="#0D825E" />
          <text x="30" y="23" fill="#0D825E" font-family="IBM Plex Mono" font-size="10.5" font-weight="700" letter-spacing="0.5">
            01. PERCEPTION
          </text>
          <rect x="168" y="10" width="65" height="18" rx="3" fill="#FFFFFF" stroke="rgba(13, 130, 94, 0.3)" />
          <text x="200" y="22" fill="#0D825E" font-family="IBM Plex Mono" font-size="8.5" font-weight="600" text-anchor="middle">
            ONNX INT8
          </text>

          <!-- Card Content -->
          <text x="16" y="62" class="card-title" font-family="Newsreader" font-size="16" font-weight="600" fill="#182334">
            Roadway Vision &amp; Geometry
          </text>
          <text x="16" y="82" class="card-body" font-family="IBM Plex Sans" font-size="11.5" fill="#475569">
            YOLOv8s + SegFormer-B0 ONNX
          </text>
          <text x="16" y="100" class="card-body" font-family="IBM Plex Sans" font-size="11" fill="#64748B">
            3-Way Gating (Accept / Review / Reject)
          </text>

          <!-- Metric Pill -->
          <rect x="16" y="115" width="213" height="22" rx="4" fill="#E8F5E9" stroke="rgba(13, 130, 94, 0.35)" />
          <text x="122" y="130" fill="#0D825E" font-family="IBM Plex Mono" font-size="9" font-weight="700" text-anchor="middle">
            ROADWATCH · 19.7k FRAMES EVAL
          </text>
        </g>

        <!-- ================= PILLAR 2: REASONING ================= -->
        <g class="map-pillar-card" id="pillar-reasoning" transform="translate(670, 65)">
          <!-- Card Body with Shadow -->
          <rect x="0" y="0" width="245" height="150" rx="8" fill="#FFFFFF" stroke="#3157B8" stroke-width="1.5" filter="url(#node-shadow)" />

          <!-- Header Bar -->
          <rect x="1" y="1" width="243" height="36" rx="7" fill="url(#header-grad-reasoning)" />
          <line x1="0" y1="37" x2="245" y2="37" stroke="rgba(49, 87, 184, 0.25)" stroke-width="1" />

          <!-- Header Icons & Title -->
          <circle cx="18" cy="19" r="4.5" fill="#3157B8" />
          <text x="30" y="23" fill="#3157B8" font-family="IBM Plex Mono" font-size="10.5" font-weight="700" letter-spacing="0.5">
            02. REASONING
          </text>
          <rect x="176" y="10" width="57" height="18" rx="3" fill="#FFFFFF" stroke="rgba(49, 87, 184, 0.3)" />
          <text x="204" y="22" fill="#3157B8" font-family="IBM Plex Mono" font-size="8.5" font-weight="600" text-anchor="middle">
            VLN · R2R
          </text>

          <!-- Card Content -->
          <text x="16" y="62" class="card-title" font-family="Newsreader" font-size="16" font-weight="600" fill="#182334">
            Embodied AI &amp; Grounding
          </text>
          <text x="16" y="82" class="card-body" font-family="IBM Plex Sans" font-size="11.5" fill="#475569">
            Topological Navigation Graphs
          </text>
          <text x="16" y="100" class="card-body" font-family="IBM Plex Sans" font-size="11" fill="#64748B">
            R2R Benchmark (+8.28% SPL Gain)
          </text>

          <!-- Metric Pill -->
          <rect x="16" y="115" width="213" height="22" rx="4" fill="#EBF1FC" stroke="rgba(49, 87, 184, 0.35)" />
          <text x="122" y="130" fill="#3157B8" font-family="IBM Plex Mono" font-size="9" font-weight="700" text-anchor="middle">
            DyGRAV · MDPI INFORMATION '26
          </text>
        </g>

        <!-- ================= PILLAR 3: TRUSTED SYSTEMS ================= -->
        <g class="map-pillar-card" id="pillar-trustworthy" transform="translate(357, 280)">
          <!-- Card Body with Shadow -->
          <rect x="0" y="0" width="245" height="150" rx="8" fill="#FFFFFF" stroke="#B45309" stroke-width="1.5" filter="url(#node-shadow)" />

          <!-- Header Bar -->
          <rect x="1" y="1" width="243" height="36" rx="7" fill="url(#header-grad-trust)" />
          <line x1="0" y1="37" x2="245" y2="37" stroke="rgba(180, 83, 9, 0.25)" stroke-width="1" />

          <!-- Header Icons & Title -->
          <circle cx="18" cy="19" r="4.5" fill="#B45309" />
          <text x="30" y="23" fill="#B45309" font-family="IBM Plex Mono" font-size="10.5" font-weight="700" letter-spacing="0.5">
            03. TRUSTED SYSTEMS
          </text>
          <rect x="172" y="10" width="61" height="18" rx="3" fill="#FFFFFF" stroke="rgba(180, 83, 9, 0.3)" />
          <text x="202" y="22" fill="#B45309" font-family="IBM Plex Mono" font-size="8.5" font-weight="600" text-anchor="middle">
            ACPI / EV
          </text>

          <!-- Card Content -->
          <text x="16" y="62" class="card-title" font-family="Newsreader" font-size="16" font-weight="600" fill="#182334">
            Firmware &amp; Cryptography
          </text>
          <text x="16" y="82" class="card-body" font-family="IBM Plex Sans" font-size="11.5" fill="#475569">
            ACPI / SSDT Hardware Bounds
          </text>
          <text x="16" y="100" class="card-body" font-family="IBM Plex Sans" font-size="11" fill="#64748B">
            4×4 EV Dynamic Charging Taxonomy
          </text>

          <!-- Metric Pill -->
          <rect x="16" y="115" width="213" height="22" rx="4" fill="#FEF3C7" stroke="rgba(180, 83, 9, 0.35)" />
          <text x="122" y="130" fill="#B45309" font-family="IBM Plex Mono" font-size="9" font-weight="700" text-anchor="middle">
            PREYSENSE &amp; DWC-FASTAUTH
          </text>
        </g>
      </svg>

      <!-- Interactive Commentary Grid Below the Map -->
      <div class="map-interactive-legend" id="map-legend">
        <div class="legend-card legend-card-perception" data-pillar="perception">
          <div class="legend-card-header">
            <div class="legend-pillar-badge badge-perception">
              <span class="legend-pillar-dot dot-perception"></span>
              <span>DOMAIN 01 // PERCEPTION</span>
            </div>
            <span class="legend-metric-pill">19.7k Frames</span>
          </div>
          <h3 class="legend-pillar-name">Edge Spatial Geometry</h3>
          <p class="legend-desc">
            Focuses on robust environmental feature extraction under resource constraints. <strong>RoadWatch</strong> couples YOLOv8s bounding boxes with SegFormer road masks to filter 162 off-road false detections across 19,784 dashcam frames in real-time.
          </p>
          <div class="legend-footer">
            <span class="legend-tech-tag">YOLOv8s · SegFormer INT8 · AWS EC2</span>
          </div>
        </div>

        <div class="legend-card legend-card-reasoning" data-pillar="reasoning">
          <div class="legend-card-header">
            <div class="legend-pillar-badge badge-reasoning">
              <span class="legend-pillar-dot dot-reasoning"></span>
              <span>DOMAIN 02 // REASONING</span>
            </div>
            <span class="legend-metric-pill">80.28% SR</span>
          </div>
          <h3 class="legend-pillar-name">Relational Embodied AI</h3>
          <p class="legend-desc">
            Investigates how agents translate high-level natural language instructions into physical action sequences. <strong>DyGRAV</strong> achieves 80.28% SR and 76.41% SPL on Room-to-Room unseen environments with 97.33% compute compliance.
          </p>
          <div class="legend-footer">
            <span class="legend-tech-tag">DyGRAV · Topological Graphs · R2R</span>
          </div>
        </div>

        <div class="legend-card legend-card-trustworthy" data-pillar="trustworthy">
          <div class="legend-card-header">
            <div class="legend-pillar-badge badge-trustworthy">
              <span class="legend-pillar-dot dot-trustworthy"></span>
              <span>DOMAIN 03 // TRUSTED SYSTEMS</span>
            </div>
            <span class="legend-metric-pill">70+ Stars · LNNS</span>
          </div>
          <h3 class="legend-pillar-name">Hardware &amp; Cryptography</h3>
          <p class="legend-desc">
            Enforces strict physical and cryptographic guarantees. <strong>DWC-FastAuth</strong> categorizes 53 EV charging protocols in Springer LNNS, while <strong>PreySense</strong> controls ACPI/EC firmware thermal limits with 70+ GitHub stars.
          </p>
          <div class="legend-footer">
            <span class="legend-tech-tag">ACPI/SSDT · .NET 10 · EV FastAuth</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

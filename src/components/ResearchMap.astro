---
const domains = [
  { id: 'perception', number: '01', name: 'Perception', question: 'What is around us?', detail: 'Roadway detection, segmentation, and human-reviewed hazard triage.', project: 'RoadWatch', href: '#case-roadwatch', tools: 'YOLOv8s / SegFormer / ONNX' },
  { id: 'reasoning', number: '02', name: 'Reasoning', question: 'How do we get there?', detail: 'Grounding language in visual landmarks and navigation graphs.', project: 'DyGRAV', href: '#case-dygrav', tools: 'Embodied AI / VLN / R2R' },
  { id: 'trustworthy', number: '03', name: 'Trustworthy systems', question: 'What can we rely on?', detail: 'Authentication for EV charging and low-level hardware control.', project: 'DWC-FastAuth & PreySense', href: '#case-dwc-fastauth', tools: 'Cryptography / ACPI / EC' },
];
---
<section class="research-map-section" id="research-map" aria-labelledby="atlas-title"><div class="atlas-container">
  <div class="section-header compact-header"><div><p class="eyebrow">01 / Research agenda</p><h2 class="section-title" id="atlas-title">One question. Three perspectives.</h2></div><p class="section-desc">How can intelligent systems work reliably in the physical world?</p></div>
  <div class="research-atlas">
    <div class="atlas-domains">{domains.map(domain => <article class={'atlas-domain domain-' + domain.id}><span class="domain-number">{domain.number} <span aria-hidden="true">/</span></span><h3>{domain.name}</h3><p class="domain-question">{domain.question}</p><p class="domain-detail">{domain.detail}</p>{domain.id === 'trustworthy' ? <div class="domain-projects"><a class="domain-project" href="#case-dwc-fastauth">DWC-FastAuth </a><a class="domain-project" href="#case-preysense">PreySense </a></div> : <a class="domain-project" href={domain.href}>{domain.project}</a>}<span class="domain-tools">{domain.tools}</span></article>)}</div>
    <p class="atlas-caption"><span class="figure-label">FIG. 01</span> A conceptual map of my research interests. Select a project to explore the work.</p>
  </div>
</div></section>

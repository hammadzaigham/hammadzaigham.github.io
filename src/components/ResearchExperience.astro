---
import { RESEARCH_DATA } from '../data/researchData';
const { researchExperience } = RESEARCH_DATA;
---
<section class="experience-section" id="experience" aria-labelledby="experience-title"><div class="atlas-container">
  <div class="section-header"><h2 class="section-title" id="experience-title">Research &amp; experience</h2></div>
  <div class="exp-list">{researchExperience.map(exp => <article class="exp-entry"><div class="exp-date"><span>{exp.period}</span><span>{exp.location}</span></div><div class="exp-content"><h3 class="exp-org-name">{exp.organization}</h3><p class="exp-role-line">{exp.role}{exp.advisor ? ' · Advisor: ' + exp.advisor : ''}</p><div class="exp-topics-list">{exp.topics.map(topic => <div class="exp-topic-block"><h4>{topic.title}</h4><ul>{topic.bullets.map(bullet => <li>{bullet}</li>)}</ul></div>)}</div></div></article>)}</div>
</div></section>

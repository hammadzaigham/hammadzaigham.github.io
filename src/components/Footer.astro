---
import { RESEARCH_DATA } from '../data/researchData';
const { candidate } = RESEARCH_DATA;
---

<footer class="site-footer" id="contact">
  <div class="atlas-container">
    <div class="footer-inner-grid">
      <!-- Col 1: Identity & Research Agenda -->
      <div>
        <div class="footer-col-title">RESEARCH ATLAS &bull; SCHOLAR IDENTITY</div>
        <h3 class="footer-name">{candidate.name}</h3>
        <p class="footer-bio-text">
          Undergraduate researcher at the University of Southern Mississippi investigating embodied perception, relational graph reasoning, and verified hardware/cryptographic limits.
        </p>
        <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); margin-top: 0.8rem;">
          <div>Location: {candidate.location}</div>
          <div style="margin-top: 0.2rem;">Target: Fall 2027 Ph.D. Admissions & Lab Visits</div>
        </div>
      </div>

      <!-- Col 2: Verified Artifacts & Exports -->
      <div>
        <div class="footer-col-title">PRIMARY ARTIFACTS</div>
        <ul class="footer-links-list">
          <li class="footer-link-item">
            <a href="./cv.tex" download="hammad_ahmed_cv.tex">
              <strong>Download cv.tex</strong> (Raw LaTeX Source)
            </a>
          </li>
          <li class="footer-link-item">
            <a href="https://doi.org/10.3390/info17101030" target="_blank" rel="noopener noreferrer">
              DyGRAV (MDPI Information 2026)
            </a>
          </li>
          <li class="footer-link-item">
            <a href="https://3-141-198-95.sslip.io/" target="_blank" rel="noopener noreferrer">
              RoadWatch (Live AWS EC2)
            </a>
          </li>
          <li class="footer-link-item">
            <a href="https://github.com/hammadzaigham/PreySense" target="_blank" rel="noopener noreferrer">
              PreySense (70+ GitHub Stars)
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Direct Inquiries -->
      <div>
        <div class="footer-col-title">COMMUNICATION</div>
        <ul class="footer-links-list">
          <li class="footer-link-item">
            <a href={`mailto:${candidate.email}`}>{candidate.email}</a>
          </li>
          <li class="footer-link-item">
            <a href={candidate.github} target="_blank" rel="noopener noreferrer">github.com/{candidate.githubHandle}</a>
          </li>
          <li class="footer-link-item">
            <span style="font-family: var(--font-mono); font-size: 0.86rem; color: var(--text-muted);">{candidate.phone}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Colophon Bottom Bar -->
    <div class="footer-colophon">
      <div>
        &copy; {new Date().getFullYear()} Hammad Ahmed &bull; The Research Atlas &bull; Built with Astro static-first &bull; Deployed on GitHub Pages
      </div>
      <div>
        <a href="#top-nav" style="text-decoration: none; color: var(--text-muted);">&uarr; Back to top</a>
      </div>
    </div>
  </div>
</footer>

---
interface Props { kind: 'reasoning' | 'trustworthy' | 'perception'; compact?: boolean; }
const { kind } = Astro.props;
---
<figure class={'research-figure figure-' + kind}>
  {kind === 'reasoning' ? <svg viewBox="0 0 360 250" fill="none" role="img" aria-labelledby="navigation-figure-title navigation-figure-desc">
    <title id="navigation-figure-title">Language-grounded navigation</title><desc id="navigation-figure-desc">Conceptual illustration: language grounds visual landmarks in a navigation graph, helping an agent choose a route to a goal. This is not an experimental trajectory.</desc>
    <defs><pattern id="nav-grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="0.8" fill="#d2dce8"/></pattern></defs>
    <rect width="360" height="250" fill="#f0f4fa"/><rect width="360" height="250" fill="url(#nav-grid)"/>
    <text x="22" y="32" class="figure-text diagram-heading">Grounding an instruction</text>
    <path d="M22 46h316" stroke="#d2dce8" />
    <path d="m44 188 69-73 75 42 117-68M44 188l94 17 50-48M113 115l57-42 135 16M188 157l58 45 59-113" stroke="#bac7d8" stroke-width="1.5" stroke-dasharray="4 5"/>
    <path class="navigation-route" pathLength="1" d="m44 188 69-73 75 42 117-68" stroke="#3157b8" stroke-width="3" stroke-linecap="round"/>
    <path d="m113 115 57-42 18 84Z" fill="#3157b8" fill-opacity=".07" stroke="#3157b8" stroke-opacity=".24"/>
    <g fill="#fff" stroke="#bac7d8" stroke-width="2"><circle cx="138" cy="205" r="5"/><circle cx="170" cy="73" r="5"/><circle cx="246" cy="202" r="5"/></g>
    <g fill="#3157b8" stroke="#fff" stroke-width="3"><circle cx="44" cy="188" r="8"/><circle cx="113" cy="115" r="8"/><circle cx="188" cy="157" r="8"/></g>
    <circle cx="305" cy="89" r="16" stroke="#16745b" stroke-dasharray="3 3"/><circle cx="305" cy="89" r="8" fill="#16745b"/>
    <text x="27" y="222" class="figure-text">Start</text><text x="288" y="62" class="figure-text">Goal</text><text x="121" y="103" class="figure-text" fill="#3157b8">Landmark</text>
  </svg> : <svg viewBox="0 0 360 250" fill="none" role="img" aria-labelledby="taxonomy-figure-title taxonomy-figure-desc">
    <title id="taxonomy-figure-title">Two-step EV authentication taxonomy</title><desc id="taxonomy-figure-desc">Conceptual illustration of a four by four taxonomy: four communication interfaces crossed with four cryptographic techniques, used to classify 53 EV charging studies. Cells do not encode study counts.</desc>
    <rect width="360" height="250" fill="#f4f5f0"/>
    <text x="24" y="34" class="figure-text">EV charging authentication</text>
    <path d="M24 47h312" stroke="#d5dace"/>
    <text x="156" y="72" class="figure-text">4 techniques</text>
    <g stroke="#c8d3c8" fill="white">{[0,1,2,3].map(row => [0,1,2,3].map(col => <rect class="taxonomy-cell" style={`--cell-index:${row*4+col}`} x={124+col*40} y={87+row*31} width="34" height="25" rx="3"/>))}</g>
    <g fill="#22765e" fill-opacity=".14"><rect x="124" y="87" width="34" height="25" rx="3"/><rect x="164" y="118" width="34" height="25" rx="3"/><rect x="204" y="149" width="34" height="25" rx="3"/><rect x="244" y="180" width="34" height="25" rx="3"/></g>
    <path d="M111 87h-6v118h6M124 215v5h154v-5" stroke="#22765e" stroke-width="1.5"/>
    <text x="24" y="140" class="figure-text">4 interfaces</text>
    <text x="24" y="235" class="figure-text">53 studies · two-step classification</text>
  </svg>}
  <figcaption>{kind === 'reasoning' ? 'Language, landmarks & navigation graphs' : 'Communication interfaces × cryptographic techniques'}<span>Conceptual schematic</span></figcaption>
</figure>
